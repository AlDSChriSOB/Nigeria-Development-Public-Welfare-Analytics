<datasource caption="Storage and Market Access" inline="true" version="18.1"><connection class="textscan" directory="../outputs" filename="analysis.csv" separator="," header="yes" character-set="UTF-8" /><column datatype="date" name="[period]" role="dimension" type="ordinal" /><column datatype="string" name="[geography]" role="dimension" type="ordinal" /><column datatype="string" name="[metric]" role="dimension" type="ordinal" /><column datatype="real" name="[value]" role="measure" type="quantitative" /><column datatype="string" name="[unit]" role="dimension" type="ordinal" /><column datatype="string" name="[vintage]" role="dimension" type="ordinal" /><column datatype="real" name="[absolute_change]" role="measure" type="quantitative" /><column datatype="real" name="[relative_change_pct]" role="measure" type="quantitative" /><column caption="Observed value" datatype="real" name="[Observed Value]" role="measure" type="quantitative"><calculation class="tableau" formula="MIN([value])" /></column></datasource>